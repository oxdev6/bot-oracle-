{
  "name": "@bot-oracle/node-client",
  "version": "1.0.0",
  "private": true,
  "description": "Lodestar Oracle node operator client - fetch, aggregate, and attest prices on BOT Chain",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "node": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}