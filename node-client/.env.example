# ─── Required ──────────────────────────────────────────────
# RPC_URL accepts a comma-separated list. The first entry is preferred and the
# rest are used as automatic fallbacks if it errors or rate-limits.
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968
AGGREGATOR_ADDRESS=0x0000000000000000000000000000000000000000
OPERATOR_KEY=0xabc...def   # 0x + 64-hex-char private key (never commit)

# ─── Optional ──────────────────────────────────────────────
# SCANNER_URL=https://scan.bohr.life
# MAX_LOCAL_DEVIATION_PCT=2
# JITTER_SECONDS=4
# CONFIG_PATH=config/feeds.json
#
# Structured logging: pretty (default, human) or json (for log shippers).
# LOG_LEVEL=info            # debug | info | warn | error
# LOG_FORMAT=pretty         # pretty | json

# Health / metrics HTTP server (Kubernetes probes, Prometheus scrape).
# HEALTH_PORT=9464
# HEALTH_DISABLED=false     # set true to disable the server entirely

# Fraction of the remaining round window to wait before retrying a failed
# round (0 = immediate, 1 = wait until the round closes). Default 0.5.
# RETRY_BACKOFF_FRACTION=0.5

# Example multi-RPC setup:
# RPC_URL=https://rpc.bohr.life,https://rpc-backup.example.org
