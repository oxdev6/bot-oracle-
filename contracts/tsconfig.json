{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node", "mocha", "chai"]
  },
  "include": ["./hardhat.config.ts", "./scripts", "./test", "./config"],
  "exclude": ["node_modules"]
}