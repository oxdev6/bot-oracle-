# ---- contracts/.env.example ----
# Copy to .env and fill in. NEVER commit .env.

# Deployer private key (keep funded with ~0.1 BOT on testnet, ~1 on mainnet)
DEPLOY_KEY=
# Fallback name if DEPLOY_KEY is blank
PRIVATE_KEY=

# RPC endpoints
BOT_TESTNET_RPC=https://rpc.bohr.life
BOT_MAINNET_RPC=https://rpc.botchain.ai

# Verification API keys (optional, needed for Etherscan-style verification)
BOT_TESTNET_ETHERSCAN_KEY=
BOT_MAINNET_ETHERSCAN_KEY=