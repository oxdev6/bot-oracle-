# ---------------- Root .env.example ----------------
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The three sub-projects (contracts/, node-client/, dashboard/) each have
# their own `.env.example` with project-specific variables.

# Optional: convention the deploy helpers share
BOT_TESTNET_RPC=https://rpc.bohr.life
BOT_MAINNET_RPC=https://rpc.botchain.ai

# Chain IDs
BOT_TESTNET_CHAIN_ID=968
BOT_MAINNET_CHAIN_ID=677